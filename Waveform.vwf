/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off cgp_system_static -c wrapper --vector_source="/media/lg/disk2/praktyka/workspace/cgp_system_static/Waveform.vwf" --testbench_file="/media/lg/disk2/praktyka/workspace/cgp_system_static/simulation/qsim/Waveform.vwf.vht"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off cgp_system_static -c wrapper --vector_source="/media/lg/disk2/praktyka/workspace/cgp_system_static/Waveform.vwf" --testbench_file="/media/lg/disk2/praktyka/workspace/cgp_system_static/simulation/qsim/Waveform.vwf.vht"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=vhdl --output_directory="/media/lg/disk2/praktyka/workspace/cgp_system_static/simulation/qsim/" cgp_system_static -c wrapper</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=vhdl --output_directory="/media/lg/disk2/praktyka/workspace/cgp_system_static/simulation/qsim/" cgp_system_static -c wrapper</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vcom -work work wrapper.vho
vcom -work work Waveform.vwf.vht
vsim -voptargs="+acc" -c -t 1ps -L cycloneive -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.wrapper_vhd_vec_tst
vcd file -direction cgp_system_static.msim.vcd
vcd add -internal wrapper_vhd_vec_tst/*
vcd add -internal wrapper_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f

</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vcom -work work wrapper.vho
vcom -work work Waveform.vwf.vht
vsim -novopt -c -t 1ps -sdfmax wrapper_vhd_vec_tst/i1=wrapper_vhd.sdo -L cycloneive -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.wrapper_vhd_vec_tst
vcd file -direction cgp_system_static.msim.vcd
vcd add -internal wrapper_vhd_vec_tst/*
vcd add -internal wrapper_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f

</modelsim_script_timing>
<hdl_lang>vhdl</hdl_lang>
</simulation_settings>*/
